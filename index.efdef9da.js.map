"use strict";
document.addEventListener("click", function(e) {
    var wall = document.querySelector(".wall");
    var wallPrefs = wall.getBoundingClientRect();
    var x = e.clientX - wallPrefs.left - wall.clientLeft;
    var y = e.clientY - wallPrefs.top - wall.clientTop;
    var spider = document.querySelector(".spider");
    var spiderWidth = spider.offsetWidth;
    var spiderHeight = spider.offsetHeight;
    var pointerX = e.clientX;
    var pointerY = e.clientY;
    if (pointerX >= wallPrefs.left && pointerX <= wallPrefs.right && pointerY >= wallPrefs.top && pointerY <= wallPrefs.bottom) {
        var coordLeft = Math.max(0, Math.min(x - spiderWidth / 2, wall.clientWidth - spiderWidth));
        var coordTop = Math.max(0, Math.min(y - spiderHeight / 2, wall.clientHeight - spiderHeight));
        spider.style.top = "".concat(coordTop, "px");
        spider.style.left = "".concat(coordLeft, "px");
    }
});

